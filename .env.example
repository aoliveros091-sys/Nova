# Copy to .env for npm start. On a host, add these in the dashboard instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional fixed model for background memory. Otherwise use the conversation model.
# OPENROUTER_MEMORY_MODEL=openrouter/free
# Optional shared password for using this site's AI. Never use your API key here.
AI_ACCESS_CODE=
